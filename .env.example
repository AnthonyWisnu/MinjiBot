# MinjiBot Environment Variables Example
# Duplicate this file to .env and configure values according to your environment.

NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minjibot?schema=public"
COMMAND_PREFIX="."
SUPER_OWNER_JIDS="6281234567890@s.whatsapp.net"
SESSION_DIR="./sessions"
TEMP_DIR="./tmp"
LOG_LEVEL="info"
BOT_BROWSER_NAME="MinjiBot"
RECONNECT_INITIAL_MS=3000
RECONNECT_MAX_MS=60000

# Media & Downloader Configuration
MAX_DOWNLOAD_FILE_MB=400
DOWNLOADER_BIN="yt-dlp"
GALLERY_DL_BIN="gallery-dl"
DOWNLOADER_COOKIES_PATH=""
YOUTUBE_COOKIES_PATH=""
INSTAGRAM_COOKIES_PATH=""
TIKTOK_COOKIES_PATH=""
TWITTER_COOKIES_PATH=""
DOWNLOADER_TIMEOUT_MS=300000
FFMPEG_PATH=""

# HD Image Processing
HD_MAX_INPUT_MB=10
HD_AI_MAX_CONCURRENT_JOBS=2

# Tenant & Reminder Configuration
TENANT_SESSION_TTL_DAYS=7
REMINDER_POLL_MS=30000
BOT_AVATAR_PATH="assets/minji.png"
